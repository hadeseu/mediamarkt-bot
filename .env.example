# Diese Datei heißt auf dem Hoster ".env" – niemals auf GitHub hochladen!
DISCORD_TOKEN=dein-bot-token
CHANNEL_ID=123456789012345678
PING_USER_ID=123456789012345678
# GitHub-Repo für automatische Updates (dein GitHub-Name/mediamarkt-bot)
UPDATE_REPO=hadeseu/mediamarkt-bot
# Wie oft jedes Produkt geprüft wird (Sekunden, mindestens 10)
CHECK_SECONDS=10
# Mindestabstand zwischen zwei Anfragen an MediaMarkt (Sekunden, mindestens 2)
MIN_GAP_SECONDS=3
# true = auch pingen, wenn nur ein Marktplatz-Händler (oft teurer) es anbietet
ALLOW_MARKETPLACE=false
